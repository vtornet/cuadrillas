# Puerto (Railway lo inyecta como PORT).
PORT=8080

# MongoDB. En local: mongodb://127.0.0.1:27017/cuadrilla
MONGODB_URI=mongodb://127.0.0.1:27017/cuadrilla

# Secreto para firmar los JWT. Cambialo en produccion.
JWT_SECRET=dev-secret-no-usar-en-produccion

# URL de la PWA (para construir el enlace magico y las vueltas de Stripe Checkout).
# Local: http://localhost:5173 — Produccion: https://cuadrillas.app
APP_URL=http://localhost:5173

# Envio de email. Si RESEND_API_KEY esta vacio, el enlace se escribe en consola.
RESEND_API_KEY=
EMAIL_FROM=Cuadrilla <login@cuadrillas.app>

# Stripe. Si STRIPE_SECRET_KEY esta vacio, los endpoints de pago responden 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOREMAN=price_...
STRIPE_PRICE_COMPANY=price_...
STRIPE_PRICE_CAMPAIGN=price_...
